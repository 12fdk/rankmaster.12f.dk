---
// The homepage. Section order is the StoryBrand order from MESSAGING.md §9:
// hero → stakes → the problem made visible → three benefits → guide → how it
// works → screenshots → modes → the five commitments → FAQ → final CTA.
//
// The one-question demo is not in that list — it is the transitional CTA from
// §5, and §9 only places the *link* to it in the hero. It sits here, straight
// after the villain panel: that panel argues in pictures that a near miss
// should count, and the demo is where the visitor gets to feel it. The three
// benefits then read as evidence for something they have already experienced
// rather than as claims about something they have not.
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Stakes from "../components/Stakes.astro";
import Villain from "../components/Villain.astro";
import TryOne from "../components/TryOne.astro";
import Benefits from "../components/Benefits.astro";
import Guide from "../components/Guide.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Screenshots from "../components/Screenshots.astro";
import Modes from "../components/Modes.astro";
import Commitments from "../components/Commitments.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { HOME_FAQ, faqSchema } from "../data/faq";
import {
  SITE,
  ORG_ID,
  WEBSITE_ID,
  APP_ID_ANCHOR,
  APP_NAME,
  APP_STORE_URL,
  MIN_IOS,
  ONE_LINER,
} from "../consts";

const title = "RankMaster — the quiz where nearly right still scores";
const description =
  "Ten questions a day. Slide to your guess instead of picking one, and see exactly how close you were. A free iPhone game with no ads, no sign-up and no tracking.";

// VideoGame rather than a bare SoftwareApplication: it is a game, and the
// category is what tells a search engine which shelf it belongs on.
//
// There is no aggregateRating here and there must not be one until the app has
// real ratings — 0 reviews as of 2026-09-19 (MESSAGING.md §0). An offer at
// price 0 is a fact about the app, not social proof, so it stays.
const appSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VideoGame",
      "@id": APP_ID_ANCHOR,
      name: APP_NAME,
      alternateName: "RankMaster",
      url: `${SITE}/`,
      description: ONE_LINER,
      applicationCategory: "GameApplication",
      genre: ["Trivia", "Puzzle"],
      gamePlatform: "iOS",
      operatingSystem: `iOS ${MIN_IOS} or later`,
      contentRating: "4+",
      installUrl: APP_STORE_URL,
      sameAs: APP_STORE_URL,
      inLanguage: ["en", "da", "de", "es", "fr", "it", "nl", "nb", "pt-BR", "sv"],
      image: `${SITE}/images/og-image.png`,
      screenshot: [
        `${SITE}/images/screenshots/en-US/02_Reveal.jpg`,
        `${SITE}/images/screenshots/en-US/01_Guess.jpg`,
        `${SITE}/images/screenshots/en-US/04_Leaderboard.jpg`,
      ],
      publisher: { "@id": ORG_ID },
      author: { "@id": ORG_ID },
      isPartOf: { "@id": WEBSITE_ID },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: APP_STORE_URL,
      },
    },
    faqSchema(HOME_FAQ, `${SITE}/#faq`),
  ],
};
---

<Layout title={title} description={description} canonical={`${SITE}/`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <link
      rel="preload"
      as="image"
      href="/images/screenshots/en-US/02_Reveal.avif"
      type="image/avif"
    />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>

  <Hero />

  <main id="main">
    <Stakes />
    <Villain />

    <section class="section container try-section" id="try-section" data-reveal>
      <h2 class="try-section__heading">Try one question, right here.</h2>
      <TryOne />
    </section>

    <Benefits />
    <Guide />
    <HowItWorks />
    <Screenshots />
    <Modes />
    <Commitments />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
</Layout>
