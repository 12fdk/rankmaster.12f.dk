---
import { ONE_LINER, ORG_NAME, ORG_CVR, ORG_URL, SUPPORT_EMAIL, APP_STORE_URL } from "../consts";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="wordmark" href="/" aria-label="RankMaster">
      <img src="/images/emblem.svg" alt="" width="26" height="26" />
      <span aria-hidden="true">RANK<b>MASTER</b></span>
    </a>

    <p class="footer__oneliner">{ONE_LINER}</p>

    <ul class="footer__links">
      <li><a href="/privacy-policy.html">Privacy policy</a></li>
      <li><a href="/support.html">Support</a></li>
      <li><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
      <li><a href={APP_STORE_URL}>App Store</a></li>
    </ul>

    <p class="small footer__legal">
      &copy; {year} <a href={ORG_URL}>{ORG_NAME}</a> · CVR {ORG_CVR} · Denmark
    </p>
  </div>
</footer>
