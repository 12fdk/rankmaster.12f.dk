---
// Placeholder. The real homepage — section order and copy from MESSAGING.md §9
// — is 12fdk/rankmaster.12f.dk#4. This exercises the foundation only: the
// layout shell, the stage, the wordmark, the eyebrow and the two buttons.
import Layout from "../layouts/Layout.astro";
import { APP_STORE_URL, CTA_LABEL, ONE_LINER, APP_NAME } from "../consts";
---

<Layout title={APP_NAME} description={ONE_LINER}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="stage">
    <div class="stage__art" aria-hidden="true" role="presentation"></div>
    <div class="stage__scrim" aria-hidden="true" role="presentation"></div>
    <div class="container">
      <nav aria-label="Primary" style="padding-block: 16px;">
        <a class="wordmark" href="/" aria-label="RankMaster">
          <img src="/images/emblem.svg" alt="" width="26" height="26" />
          <span aria-hidden="true">RANK<b>MASTER</b></span>
        </a>
      </nav>
      <div class="section">
        <p class="eyebrow">Foundation preview</p>
        <h1>Find out how well you really know the world.</h1>
        <p class="lede" style="margin-top: 24px;">
          Ten questions a day. Slide to your guess — the closer you land, the more you score.
        </p>
        <p style="margin-top: 32px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
          <a class="btn btn--primary" href={APP_STORE_URL}>{CTA_LABEL}</a>
          <a class="badge-link" href={APP_STORE_URL} aria-label="Download on the App Store">
            <img src="/images/app-store-badge.svg" alt="" height="54" width="161" />
          </a>
        </p>
        <p class="small" style="margin-top: 20px;">
          Free · No ads · No sign-up · No tracking
        </p>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="section container">
      <p class="eyebrow">Surfaces</p>
      <div class="panel" style="max-width: 34rem;">
        <h2>Nearly right has never counted.</h2>
        <p style="margin-top: 16px;">
          Body copy on <code>--surface</code>, to check the raised panel reads as raised without a
          shadow.
        </p>
        <p class="citation" style="margin-top: 16px;">
          <svg viewBox="0 0 24 24" class="icon" style="width:14px;height:14px;" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path>
          </svg>
          <span>Source placeholder, 2025.</span>
        </p>
      </div>
      <p class="small" style="margin-top: 32px;">
        Replaced in full by #4.
      </p>
    </section>
  </main>
</Layout>
